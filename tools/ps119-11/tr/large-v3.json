{"tmpaudio/ps119/c01.mp3": {"words": [{"text": "There's", "start": 0.0, "end": 0.6}, {"text": "a", "start": 0.6, "end": 0.66}, {"text": "man", "start": 0.66, "end": 0.9}, {"text": "at", "start": 0.9, "end": 1.08}, {"text": "my", "start": 1.08, "end": 1.18}, {"text": "job", "start": 1.18, "end": 1.64}, {"text": "who", "start": 1.64, "end": 2.02}, {"text": "keeps", "start": 2.02, "end": 2.56}, {"text": "a", "start": 2.56, "end": 2.7}, {"text": "photo", "start": 2.7, "end": 3.02}, {"text": "of", "start": 3.02, "end": 3.22}, {"text": "his", "start": 3.22, "end": 3.38}, {"text": "kids", "start": 3.38, "end": 3.74}, {"text": "taped", "start": 3.74, "end": 4.36}, {"text": "inside", "start": 4.36, "end": 4.66}, {"text": "his", "start": 4.66, "end": 5.06}, {"text": "lunchbox.", "start": 5.06, "end": 5.56}], "text": "There's a man at my job who keeps a photo of his kids taped inside his lunchbox."}, "tmpaudio/ps119/c02.mp3": {"words": [{"text": "He", "start": 0.0, "end": 0.58}, {"text": "sees", "start": 0.58, "end": 0.84}, {"text": "it", "start": 0.84, "end": 1.02}, {"text": "every", "start": 1.02, "end": 1.3}, {"text": "day", "start": 1.3, "end": 1.54}, {"text": "at", "start": 1.54, "end": 1.76}, {"text": "noon.", "start": 1.76, "end": 2.02}, {"text": "Nobody", "start": 3.34, "end": 3.86}, {"text": "has", "start": 3.86, "end": 4.16}, {"text": "to", "start": 4.16, "end": 4.36}, {"text": "remind", "start": 4.36, "end": 4.62}, {"text": "him", "start": 4.62, "end": 4.94}, {"text": "who", "start": 4.94, "end": 5.1}, {"text": "he's", "start": 5.1, "end": 5.28}, {"text": "working", "start": 5.28, "end": 5.52}, {"text": "for.", "start": 5.52, "end": 5.84}], "text": "He sees it every day at noon. Nobody has to remind him who he's working for."}, "tmpaudio/ps119/c03.mp3": {"words": [{"text": "Thy", "start": 0.0, "end": 0.58}, {"text": "word", "start": 0.58, "end": 0.96}, {"text": "have", "start": 0.96, "end": 1.72}, {"text": "I", "start": 1.72, "end": 1.94}, {"text": "hid", "start": 1.94, "end": 2.28}, {"text": "in", "start": 2.28, "end": 2.58}, {"text": "mine", "start": 2.58, "end": 2.86}, {"text": "heart.", "start": 2.86, "end": 3.24}], "text": "Thy word have I hid in mine heart."}, "tmpaudio/ps119/c04.mp3": {"words": [{"text": "that", "start": 0.0, "end": 0.68}, {"text": "I", "start": 0.68, "end": 0.78}, {"text": "might", "start": 0.78, "end": 1.12}, {"text": "not", "start": 1.12, "end": 1.48}, {"text": "sin", "start": 1.48, "end": 1.92}, {"text": "against", "start": 1.92, "end": 2.66}, {"text": "thee.", "start": 2.66, "end": 3.14}], "text": "that I might not sin against thee."}, "tmpaudio/ps119/c05.mp3": {"words": [{"text": "That's", "start": 0.0, "end": 0.64}, {"text": "Psalm", "start": 0.64, "end": 0.92}, {"text": "119,", "start": 0.92, "end": 2.09}, {"text": "verse", "start": 2.28, "end": 2.68}, {"text": "11.", "start": 2.68, "end": 2.98}], "text": "That's Psalm 119, verse 11."}, "tmpaudio/ps119/c06.mp3": {"words": [{"text": "David", "start": 0.0, "end": 0.72}, {"text": "didn't", "start": 0.72, "end": 1.08}, {"text": "say", "start": 1.08, "end": 1.26}, {"text": "he", "start": 1.26, "end": 1.48}, {"text": "read", "start": 1.48, "end": 1.74}, {"text": "the", "start": 1.74, "end": 1.92}, {"text": "word.", "start": 1.92, "end": 2.2}, {"text": "He", "start": 2.68, "end": 3.2}, {"text": "said", "start": 3.2, "end": 3.46}, {"text": "he", "start": 3.46, "end": 3.66}, {"text": "hid", "start": 3.66, "end": 3.9}, {"text": "it", "start": 3.9, "end": 4.08}, {"text": "where", "start": 4.08, "end": 4.88}, {"text": "nobody", "start": 4.88, "end": 5.28}, {"text": "can", "start": 5.28, "end": 5.62}, {"text": "take", "start": 5.62, "end": 5.9}, {"text": "it.", "start": 5.9, "end": 6.14}], "text": "David didn't say he read the word. He said he hid it where nobody can take it."}, "tmpaudio/ps119/c07.mp3": {"words": [{"text": "You", "start": 0.0, "end": 0.64}, {"text": "only", "start": 0.64, "end": 0.86}, {"text": "hide", "start": 0.86, "end": 1.36}, {"text": "what", "start": 1.36, "end": 1.94}, {"text": "you", "start": 1.94, "end": 2.08}, {"text": "can't", "start": 2.08, "end": 2.4}, {"text": "afford", "start": 2.4, "end": 2.58}, {"text": "to", "start": 2.58, "end": 2.82}, {"text": "lose.", "start": 2.82, "end": 3.04}, {"text": "That's", "start": 3.88, "end": 4.32}, {"text": "what", "start": 4.32, "end": 4.42}, {"text": "the", "start": 4.42, "end": 4.56}, {"text": "word", "start": 4.56, "end": 4.78}, {"text": "is", "start": 4.78, "end": 5.02}, {"text": "to", "start": 5.02, "end": 5.18}, {"text": "a", "start": 5.18, "end": 5.32}, {"text": "man.", "start": 5.32, "end": 5.56}], "text": "You only hide what you can't afford to lose. That's what the word is to a man."}, "tmpaudio/ps119/c08.mp3": {"words": [{"text": "Temptation", "start": 0.0, "end": 1.02}, {"text": "doesn't", "start": 1.02, "end": 1.4}, {"text": "call", "start": 1.4, "end": 1.54}, {"text": "ahead.", "start": 1.54, "end": 1.86}, {"text": "The", "start": 2.3, "end": 2.82}, {"text": "verse", "start": 2.82, "end": 3.08}, {"text": "you", "start": 3.08, "end": 3.26}, {"text": "already", "start": 3.26, "end": 3.58}, {"text": "know", "start": 3.58, "end": 3.92}, {"text": "is", "start": 3.92, "end": 4.36}, {"text": "the", "start": 4.36, "end": 4.48}, {"text": "one", "start": 4.48, "end": 4.68}, {"text": "that", "start": 4.68, "end": 4.84}, {"text": "shows", "start": 4.84, "end": 5.06}, {"text": "up", "start": 5.06, "end": 5.3}, {"text": "in", "start": 5.3, "end": 5.44}, {"text": "time.", "start": 5.44, "end": 5.72}], "text": "Temptation doesn't call ahead. The verse you already know is the one that shows up in time."}, "tmpaudio/ps119/c09.mp3": {"words": [{"text": "One", "start": 0.0, "end": 0.56}, {"text": "verse", "start": 0.56, "end": 0.85}, {"text": "in", "start": 0.85, "end": 1.19}, {"text": "your", "start": 1.19, "end": 1.36}, {"text": "heart", "start": 1.36, "end": 1.7}, {"text": "beats", "start": 1.7, "end": 2.55}, {"text": "a", "start": 2.55, "end": 2.8}, {"text": "whole", "start": 2.8, "end": 3.09}, {"text": "Bible", "start": 3.09, "end": 3.5}, {"text": "on", "start": 3.5, "end": 4.33}, {"text": "the", "start": 4.33, "end": 4.44}, {"text": "shelf.", "start": 4.44, "end": 4.72}], "text": "One verse in your heart beats a whole Bible on the shelf."}, "tmpaudio/ps119/c10.mp3": {"words": [{"text": "Today,", "start": 0.0, "end": 0.82}, {"text": "carry", "start": 0.92, "end": 1.46}, {"text": "this", "start": 1.46, "end": 1.74}, {"text": "verse.", "start": 1.74, "end": 2.04}, {"text": "Say", "start": 2.44, "end": 2.96}, {"text": "it", "start": 2.96, "end": 3.16}, {"text": "at", "start": 3.16, "end": 3.22}, {"text": "the", "start": 3.22, "end": 3.34}, {"text": "red", "start": 3.34, "end": 3.58}, {"text": "light", "start": 3.58, "end": 3.84}, {"text": "on", "start": 3.84, "end": 4.28}, {"text": "the", "start": 4.28, "end": 4.44}, {"text": "line", "start": 4.44, "end": 4.78}, {"text": "until", "start": 4.78, "end": 5.42}, {"text": "it's", "start": 5.42, "end": 5.68}, {"text": "yours.", "start": 5.68, "end": 5.94}], "text": "Today, carry this verse. Say it at the red light on the line until it's yours."}, "tmpaudio/ps119/c11.mp3": {"words": [{"text": "Let's", "start": 0.0, "end": 0.74}, {"text": "pray.", "start": 0.74, "end": 0.92}, {"text": "Father,", "start": 1.94, "end": 2.42}, {"text": "hide", "start": 2.48, "end": 2.86}, {"text": "your", "start": 2.86, "end": 3.0}, {"text": "word", "start": 3.0, "end": 3.32}, {"text": "deep", "start": 3.32, "end": 3.62}, {"text": "in", "start": 3.62, "end": 3.78}, {"text": "us", "start": 3.78, "end": 4.04}, {"text": "where", "start": 4.04, "end": 4.7}, {"text": "the", "start": 4.7, "end": 4.86}, {"text": "day", "start": 4.86, "end": 5.06}, {"text": "can't", "start": 5.06, "end": 5.44}, {"text": "shake", "start": 5.44, "end": 5.62}, {"text": "it", "start": 5.62, "end": 5.82}, {"text": "loose.", "start": 5.82, "end": 6.06}], "text": "Let's pray. Father, hide your word deep in us where the day can't shake it loose."}, "tmpaudio/ps119/c12.mp3": {"words": [{"text": "When", "start": 0.0, "end": 0.23}, {"text": "temptation", "start": 0.23, "end": 0.47}, {"text": "comes,", "start": 0.47, "end": 0.99}, {"text": "bring", "start": 1.17, "end": 2.21}, {"text": "your", "start": 2.21, "end": 2.45}, {"text": "word", "start": 2.45, "end": 2.77}, {"text": "back", "start": 2.77, "end": 3.1}, {"text": "to", "start": 3.1, "end": 3.3}, {"text": "our", "start": 3.3, "end": 3.48}, {"text": "minds", "start": 3.48, "end": 3.91}, {"text": "before", "start": 3.91, "end": 4.37}, {"text": "we", "start": 4.37, "end": 4.66}, {"text": "move.", "start": 4.66, "end": 4.92}], "text": "When temptation comes, bring your word back to our minds before we move."}, "tmpaudio/ps119/c13.mp3": {"words": [{"text": "Keep", "start": 0.0, "end": 0.18}, {"text": "our", "start": 0.18, "end": 0.34}, {"text": "hearts", "start": 0.34, "end": 0.64}, {"text": "clean", "start": 0.64, "end": 0.9}, {"text": "before", "start": 0.9, "end": 1.26}, {"text": "you.", "start": 1.26, "end": 1.62}, {"text": "In", "start": 1.9, "end": 2.48}, {"text": "Jesus'", "start": 2.48, "end": 2.78}, {"text": "name,", "start": 2.88, "end": 3.16}, {"text": "amen.", "start": 3.32, "end": 3.74}], "text": "Keep our hearts clean before you. In Jesus' name, amen."}, "tmpaudio/ps119/c14.mp3": {"words": [{"text": "Follow", "start": 0.0, "end": 0.8}, {"text": "blessed", "start": 0.8, "end": 1.1}, {"text": "prayers", "start": 1.1, "end": 1.56}, {"text": "so", "start": 1.56, "end": 2.32}, {"text": "the", "start": 2.32, "end": 2.48}, {"text": "word", "start": 2.48, "end": 2.76}, {"text": "finds", "start": 2.76, "end": 3.18}, {"text": "you", "start": 3.18, "end": 3.52}, {"text": "on", "start": 3.52, "end": 3.82}, {"text": "the", "start": 3.82, "end": 3.92}, {"text": "hard", "start": 3.92, "end": 4.18}, {"text": "days.", "start": 4.18, "end": 4.6}, {"text": "Drop", "start": 4.84, "end": 5.44}, {"text": "an", "start": 5.44, "end": 5.62}, {"text": "amen.", "start": 5.62, "end": 5.86}], "text": "Follow blessed prayers so the word finds you on the hard days. Drop an amen."}, "tmpaudio/ps119/c15.mp3": {"words": [{"text": "Hide", "start": 0.0, "end": 0.94}, {"text": "the", "start": 0.94, "end": 1.1}, {"text": "word", "start": 1.1, "end": 1.31}, {"text": "for", "start": 1.31, "end": 1.53}, {"text": "today", "start": 1.53, "end": 1.81}, {"text": "in", "start": 1.81, "end": 2.61}, {"text": "your", "start": 2.61, "end": 2.78}, {"text": "heart", "start": 2.78, "end": 3.11}, {"text": "Have", "start": 4.21, "end": 4.72}, {"text": "a", "start": 4.72, "end": 4.85}, {"text": "blessed", "start": 4.85, "end": 5.08}, {"text": "day", "start": 5.08, "end": 5.36}], "text": "Hide the word for today in your heart Have a blessed day"}}