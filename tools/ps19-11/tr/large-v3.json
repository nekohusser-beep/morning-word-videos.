169, "end": 5.305}, {"text": "amen.", "start": 5.305, "end": 5.492}], "text": "Follow blessed prayers so the word finds you on the hard days. Drop an amen."}, "tmpaudio/ps19/c15.mp3": {"words": [{"text": "Keep", "start": 0.0, "end": 0.814}, {"text": "the", "start": 0.814, "end": 0.966}, {"text": "word", "start": 0.966, "end": 1.186}, {"text": "for", "start": 1.186, "end": 1.915}, {"text": "today.", "start": 1.915, "end": 2.203}, {"text": "Have", "start": 3.0, "end": 3.441}, {"text": "a", "start": 3.441, "end": 3.542}, {"text": "blessed", "start": 3.542, "end": 3.763}, {"text": "day.", "start": 3.763, "end": 4.017}], "text": "Keep the word for today. Have a blessed day."}}