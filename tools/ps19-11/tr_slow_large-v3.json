{"tmpaudio/ps19/c01.mp3": {"words": [{"text": "There's", "start": 0.0, "end": 0.64}, {"text": "a", "start": 0.64, "end": 0.68}, {"text": "yellow", "start": 0.68, "end": 0.94}, {"text": "tag", "start": 0.94, "end": 1.28}, {"text": "on", "start": 1.28, "end": 1.76}, {"text": "a", "start": 1.76, "end": 1.92}, {"text": "machine", "start": 1.92, "end": 2.2}, {"text": "at", "start": 2.2, "end": 2.46}, {"text": "work", "start": 2.46, "end": 2.76}, {"text": "that", "start": 2.76, "end": 3.52}, {"text": "says", "start": 3.52, "end": 3.78}, {"text": "one", "start": 3.78, "end": 4.26}, {"text": "word,", "start": 4.26, "end": 4.82}, {"text": "warning.", "start": 5.1, "end": 6.42}], "text": "There's a yellow tag on a machine at work that says one word, warning."}, "tmpaudio/ps19/c02.mp3": {"words": [{"text": "Whoever", "start": 0.0, "end": 0.7}, {"text": "wrote", "start": 0.7, "end": 0.98}, {"text": "that", "start": 0.98, "end": 1.24}, {"text": "tag", "start": 1.24, "end": 1.62}, {"text": "wasn't", "start": 1.62, "end": 2.2}, {"text": "being", "start": 2.2, "end": 2.44}, {"text": "mean.", "start": 2.44, "end": 2.84}, {"text": "He", "start": 4.32, "end": 4.9}, {"text": "was", "start": 4.9, "end": 5.1}, {"text": "trying", "start": 5.1, "end": 5.4}, {"text": "to", "start": 5.4, "end": 5.68}, {"text": "keep", "start": 5.68, "end": 5.92}, {"text": "my", "start": 5.92, "end": 6.14}, {"text": "hand.", "start": 6.14, "end": 6.52}], "text": "Whoever wrote that tag wasn't being mean. He was trying to keep my hand."}, "tmpaudio/ps19/c03.mp3": {"words": [{"text": "Moreover,", "start": 0.0, "end": 0.84}, {"text": "by", "start": 0.84, "end": 1.32}, {"text": "them", "start": 1.32, "end": 1.84}, {"text": "is", "start": 1.84, "end": 3.8}, {"text": "thy", "start": 3.8, "end": 4.1}, {"text": "servant", "start": 4.1, "end": 4.88}, {"text": "warned.", "start": 4.88, "end": 6.34}], "text": "Moreover, by them is thy servant warned."}, "tmpaudio/ps19/c04.mp3": {"words": [{"text": "and", "start": 0.0, "