[
 {
  "kind": "dre",
  "text": "Oh, that's for Miss Linda. Her birthday's today. Everybody chipped in.",
  "para_end": true,
  "in_line": false,
  "idx": 1
 },
 {
  "kind": "dre",
  "text": "Twenty dollars. I'm collecting.",
  "para_end": true,
  "in_line": false,
  "idx": 3
 },
 {
  "kind": "dre",
  "text": "I'm the gift guy now.",
  "para_end": true,
  "in_line": false,
  "idx": 5
 },
 {
  "kind": "dre",
  "text": "That's personal business. This is office business.",
  "para_end": true,
  "in_line": false,
  "idx": 7
 },
 {
  "kind": "dre",
  "text": "Two hundred and forty dollars. Twelve people.",
  "para_end": true,
  "in_line": false,
  "idx": 9
 },
 {
  "kind": "dre",
  "text": "A card.",
  "para_end": true,
  "in_line": false,
  "idx": 11
 },
 {
  "kind": "dre",
  "text": "The card is real nice, Skip. It sings.",
  "para_end": true,
  "in_line": false,
  "idx": 13
 },
 {
  "kind": "dre",
  "text": "It sings Happy Birthday AND it got glitter.",
  "para_end": true,
  "in_line": false,
  "idx": 15
 },
 {
  "kind": "dre",
  "text": "Processing fees.",
  "para_end": true,
  "in_line": false,
  "idx": 17
 },
 {
  "kind": "dre",
  "text": "Gas to the store. My time. Snacks for the drive.",
  "para_end": true,
  "in_line": false,
  "idx": 19
 },
 {
  "kind": "dre",
  "text": "Traffic was crazy.",
  "para_end": true,
  "in_line": false,
  "idx": 21
 },
 {
  "kind": "dre",
  "text": "There wasn't room for all twelve names.",
  "para_end": true,
  "in_line": false,
  "idx": 23
 },
 {
  "kind": "dre",
  "text": "I signed it on behalf of the team. That's leadership.",
  "para_end": true,
  "in_line": false,
  "idx": 25
 },
 {
  "kind": "dre",
  "text": "And she gave me a hug, too.",
  "para_end": true,
  "in_line": false,
  "idx": 27
 },
 {
  "kind": "dre",
  "text": "Yeah. And she said I'm getting a raise.",
  "para_end": true,
  "in_line": false,
  "idx": 29
 },
 {
  "kind": "dre",
  "text": "Bet. I got you Friday.",
  "para_end": true,
  "in_line": false,
  "idx": 31
 },
 {
  "kind": "dre",
  "text": "A Friday. They come every week.",
  "para_end": true,
  "in_line": false,
  "idx": 33
 }
]