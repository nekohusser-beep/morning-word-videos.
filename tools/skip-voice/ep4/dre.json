[
 {
  "kind": "dre",
  "text": "That's not your jacket. That's inventory.",
  "para_end": true,
  "in_line": false,
  "idx": 1
 },
 {
  "kind": "dre",
  "text": "I started a business. Pre-owned clothing. It's called Dre's Closet.",
  "para_end": true,
  "in_line": false,
  "idx": 3
 },
 {
  "kind": "dre",
  "text": "A lot of people named Skip.",
  "para_end": true,
  "in_line": false,
  "idx": 5
 },
 {
  "kind": "dre",
  "text": "I'm not gonna give out my customers' information.",
  "para_end": true,
  "in_line": false,
  "idx": 7
 },
 {
  "kind": "dre",
  "text": "For you? Thirty five dollars. Friends and family price.",
  "para_end": true,
  "in_line": false,
  "idx": 9
 },
 {
  "kind": "dre",
  "text": "Normally it's forty. That's a five dollar discount, Skip.",
  "para_end": true,
  "in_line": false,
  "idx": 11
 },
 {
  "kind": "dre",
  "text": "Lost and found.",
  "para_end": true,
  "in_line": false,
  "idx": 13
 },
 {
  "kind": "dre",
  "text": "Hook's in the hallway. Hallway's basically lost and found.",
  "para_end": true,
  "in_line": false,
  "idx": 15
 },
 {
  "kind": "dre",
  "text": "Look, I got other items. You like this lunch box?",
  "para_end": true,
  "in_line": false,
  "idx": 17
 },
 {
  "kind": "dre",
  "text": "Comes with a free napkin.",
  "para_end": true,
  "in_line": false,
  "idx": 19
 },
 {
  "kind": "dre",
  "text": "Adds character. Collectors love that.",
  "para_end": true,
  "in_line": false,
  "idx": 21
 },
 {
  "kind": "dre",
  "text": "Good choice. Cash App or Zelle?",
  "para_end": true,
  "in_line": false,
  "idx": 23
 },
 {
  "kind": "dre",
  "text": "Oh. So you want store credit.",
  "para_end": true,
  "in_line": false,
  "idx": 25
 },
 {
  "kind": "dre",
  "text": "Now you owe ME five dollars. Business is business.",
  "para_end": true,
  "in_line": false,
  "idx": 27
 },
 {
  "kind": "dre",
  "text": "Jacket's thirty five. Debt's forty. Plus five dollar shipping.",
  "para_end": true,
  "in_line": false,
  "idx": 29
 },
 {
  "kind": "dre",
  "text": "I'm walking it over. That's my legs, Skip.",
  "para_end": true,
  "in_line": false,
  "idx": 31
 }
]