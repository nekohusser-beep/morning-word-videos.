[
 {
  "kind": "dre",
  "text": "Smells like burnt popcorn to me.",
  "para_end": true,
  "in_line": false,
  "idx": 1
 },
 {
  "kind": "dre",
  "text": "Skip. What day you think it is?",
  "para_end": true,
  "in_line": false,
  "idx": 3
 },
 {
  "kind": "dre",
  "text": "It's Tuesday.",
  "para_end": true,
  "in_line": false,
  "idx": 5
 },
 {
  "kind": "dre",
  "text": "It's only Tuesday. Check your phone.",
  "para_end": true,
  "in_line": false,
  "idx": 7
 },
 {
  "kind": "dre",
  "text": "Your phone, my phone, and the calendar on the wall. All wrong?",
  "para_end": true,
  "in_line": false,
  "idx": 9
 },
 {
  "kind": "dre",
  "text": "You wrote Friday on it. In pen. In Tuesday's box.",
  "para_end": true,
  "in_line": false,
  "idx": 11
 },
 {
  "kind": "dre",
  "text": "That was vandalism.",
  "para_end": true,
  "in_line": false,
  "idx": 13
 },
 {
  "kind": "dre",
  "text": "Three more nights.",
  "para_end": true,
  "in_line": false,
  "idx": 15
 },
 {
  "kind": "dre",
  "text": "I noticed. You been sliding across this floor all night.",
  "para_end": true,
  "in_line": false,
  "idx": 17
 },
 {
  "kind": "dre",
  "text": "Wednesday is a hill. You climb it.",
  "para_end": true,
  "in_line": false,
  "idx": 19
 },
 {
  "kind": "dre",
  "text": "Look at the bright side. You picked up overtime Thursday and Friday.",
  "para_end": true,
  "in_line": false,
  "idx": 21
 },
 {
  "kind": "dre",
  "text": "Yesterday. You were real excited. You said it was Friday.",
  "para_end": true,
  "in_line": false,
  "idx": 23
 },
 {
  "kind": "dre",
  "text": "What does that mean?",
  "para_end": true,
  "in_line": false,
  "idx": 25
 },
 {
  "kind": "dre",
  "text": "I only buy pizza on Fridays.",
  "para_end": true,
  "in_line": false,
  "idx": 27
 },
 {
  "kind": "dre",
  "text": "Man. I walked right into that.",
  "para_end": true,
  "in_line": false,
  "idx": 29
 }
]