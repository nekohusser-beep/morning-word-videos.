[
 {
  "kind": "skip",
  "text": "Babe, I'm grabbing food. You want anything?",
  "para_end": true,
  "in_line": false,
  "idx": 0
 },
 {
  "kind": "nia",
  "text": "No, I'm good. I'm not hungry.",
  "para_end": true,
  "in_line": false,
  "idx": 1
 },
 {
  "kind": "skip",
  "text": "You sure? Last chance.",
  "para_end": true,
  "in_line": false,
  "idx": 2
 },
 {
  "kind": "nia",
  "text": "Skip. I said I'm not hungry.",
  "para_end": true,
  "in_line": false,
  "idx": 3
 },
 {
  "kind": "skip",
  "text": "Remember that. She said it twice.",
  "para_end": true,
  "in_line": false,
  "idx": 4
 },
 {
  "kind": "skip",
  "text": "Let me get one burger, one large fry...",
  "para_end": true,
  "in_line": false,
  "idx": 5
 },
 {
  "kind": "skip",
  "text": "Nah. She said she's not hungry. I trust my wife.",
  "para_end": true,
  "in_line": false,
  "idx": 6
 },
 {
  "kind": "nia",
  "text": "Ooh, that smells good.",
  "para_end": true,
  "in_line": false,
  "idx": 7
 },
 {
  "kind": "skip",
  "text": "It's a burger.",
  "para_end": true,
  "in_line": false,
  "idx": 8
 },
 {
  "kind": "nia",
  "text": "Just one fry.",
  "para_end": true,
  "in_line": false,
  "idx": 9
 },
 {
  "kind": "skip",
  "text": "That was four.",
  "para_end": true,
  "in_line": false,
  "idx": 10
 },
 {
  "kind": "nia",
  "text": "They were small.",
  "para_end": true,
  "in_line": false,
  "idx": 11
 },
 {
  "kind": "skip",
  "text": "Babe, where's my fries going?",
  "para_end": true,
  "in_line": false,
  "idx": 12
 },
 {
  "kind": "nia",
  "text": "I'm just tasting them. Making sure they're good for you.",
  "para_end": true,
  "in_line": false,
  "idx": 13
 },
 {
  "kind": "skip",
  "text": "Are they good?",
  "para_end": true,
  "in_line": false,
  "idx": 14
 },
 {
  "kind": "nia",
  "text": "Mm-hm. Very.",
  "para_end": true,
  "in_line": false,
  "idx": 15
 },
 {
  "kind": "nia",
  "text": "Skip... you awake?",
  "para_end": true,
  "in_line": false,
  "idx": 16
 },
 {
  "kind": "skip",
  "text": "...No.",
  "para_end": true,
  "in_line": false,
  "idx": 17
 },
 {
  "kind": "nia",
  "text": "I'm kinda hungry.",
  "para_end": true,
  "in_line": false,
  "idx": 18
 },
 {
  "kind": "skip",
  "text": "Four hours. FOUR HOURS. You told me not hungry with your whole chest.",
  "para_end": true,
  "in_line": false,
  "idx": 19
 },
 {
  "kind": "nia",
  "text": "That was six o'clock Nia. This is ten o'clock Nia.",
  "para_end": true,
  "in_line": false,
  "idx": 20
 },
 {
  "kind": "nia",
  "text": "You got me my own?!",
  "para_end": true,
  "in_line": false,
  "idx": 21
 },
 {
  "kind": "skip",
  "text": "Baby, I been married six years. I bought two at six o'clock.",
  "para_end": true,
  "in_line": false,
  "idx": 22
 },
 {
  "kind": "nia",
  "text": "That's why I married you.",
  "para_end": true,
  "in_line": false,
  "idx": 23
 },
 {
  "kind": "skip",
  "text": "Lesson one in marriage. Not hungry means order for two.",
  "para_end": true,
  "in_line": false,
  "idx": 24
 }
]