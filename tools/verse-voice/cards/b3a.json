[{"kind": "verse", "text": "Be still, and know that I am God:", "para_end": false, "in_line": false, "idx": 610}, {"kind": "verse", "text": "I will be exalted among the heathen,", "para_end": false, "in_line": false, "idx": 611}, {"kind": "verse", "text": "I will be exalted in the earth.", "para_end": false, "in_line": false, "idx": 612}, {"kind": "ref", "text": "Psalm forty-six, verse ten.", "para_end": true, "in_line": false, "idx": 619}, {"kind": "verse", "text": "Fear thou not; for I am with thee:", "para_end": false, "in_line": false, "idx": 620}, {"kind": "verse", "text": "be not dismayed; for I am thy God:", "para_end": false, "in_line": false, "idx": 621}, {"kind": "verse", "text": "I will strengthen thee; yea, I will help thee;", "para_end": false, "in_line": false, "idx": 622}, {"kind": "verse", "text": "yea, I will uphold thee", "para_end": false, "in_line": false, "idx": 623}, {"kind": "verse", "text": "with the right hand of my righteousness.", "para_end": false, "in_line": false, "idx": 624}, {"kind": "ref", "text": "Isaiah forty-one, verse ten.", "para_end": true, "in_line": false, "idx": 629}, {"kind": "verse", "text": "Have not I commanded thee?", "para_end": false, "in_line": false, "idx": 630}, {"kind": "verse", "text": "Be strong and of a good courage;", "para_end": false, "in_line": false, "idx": 631}, {"kind": "verse", "text": "be not afraid, neither be thou dismayed:", "para_end": false, "in_line": false, "idx": 632}, {"kind": "verse", "text": "for the LORD thy God is with thee", "para_end": false, "in_line": false, "idx": 633}, {"kind": "verse", "text": "whithersoever thou goest.", "para_end": false, "in_line": false, "idx": 634}, {"kind": "ref", "text": "Joshua one, verse nine.", "para_end": true, "in_line": false, "idx": 639}, {"kind": "verse", "text": "It is of the LORD'S mercies", "para_end": false, "in_line": false, "idx": 640}, {"kind": "verse", "text": "that we are not consumed,", "para_end": false, "in_line": false, "idx": 641}, {"kind": "verse", "text": "because his compassions fail not.", "para_end": false, "in_line": false, "idx": 642}, {"kind": "verse", "text": "They are new every morning:", "para_end": false, "in_line": false, "idx": 643}, {"kind": "verse", "text": "great is thy faithfulness.", "para_end": false, "in_line": false, "idx": 644}, {"kind": "ref", "text": "Lamentations three, verses twenty-two and twenty-three.", "para_end": true, "in_line": false, "idx": 649}]