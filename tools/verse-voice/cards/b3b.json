[{"kind": "verse", "text": "I will both lay me down in peace, and sleep:", "para_end": false, "in_line": false, "idx": 650}, {"kind": "verse", "text": "for thou, LORD, only makest me dwell in safety.", "para_end": false, "in_line": false, "idx": 651}, {"kind": "ref", "text": "Psalm four, verse eight.", "para_end": true, "in_line": false, "idx": 659}, {"kind": "verse", "text": "Cast thy burden upon the LORD,", "para_end": false, "in_line": false, "idx": 660}, {"kind": "verse", "text": "and he shall sustain thee:", "para_end": false, "in_line": false, "idx": 661}, {"kind": "verse", "text": "he shall never suffer the righteous", "para_end": false, "in_line": false, "idx": 662}, {"kind": "verse", "text": "to be moved.", "para_end": false, "in_line": false, "idx": 663}, {"kind": "ref", "text": "Psalm fifty-five, verse twenty-two.", "para_end": true, "in_line": false, "idx": 669}, {"kind": "verse", "text": "Now the God of hope fill you", "para_end": false, "in_line": false, "idx": 670}, {"kind": "verse", "text": "with all joy and peace in believing,", "para_end": false, "in_line": false, "idx": 671}, {"kind": "verse", "text": "that ye may abound in hope,", "para_end": false, "in_line": false, "idx": 672}, {"kind": "verse", "text": "through the power of the Holy Ghost.", "para_end": false, "in_line": false, "idx": 673}, {"kind": "ref", "text": "Romans fifteen, verse thirteen.", "para_end": true, "in_line": false, "idx": 679}, {"kind": "verse", "text": "Peace I leave with you,", "para_end": false, "in_line": false, "idx": 680}, {"kind": "verse", "text": "my peace I give unto you:", "para_end": false, "in_line": false, "idx": 681}, {"kind": "verse", "text": "not as the world giveth, give I unto you.", "para_end": false, "in_line": false, "idx": 682}, {"kind": "verse", "text": "Let not your heart be troubled,", "para_end": false, "in_line": false, "idx": 683}, {"kind": "verse", "text": "neither let it be afraid.", "para_end": false, "in_line": false, "idx": 684}, {"kind": "ref", "text": "John fourteen, verse twenty-seven.", "para_end": true, "in_line": false, "idx": 689}]