[{"kind": "verse", "text": "I laid me down and slept;", "para_end": false, "in_line": false, "idx": 690}, {"kind": "verse", "text": "I awaked; for the LORD sustained me.", "para_end": false, "in_line": false, "idx": 691}, {"kind": "ref", "text": "Psalm three, verse five.", "para_end": true, "in_line": false, "idx": 699}, {"kind": "verse", "text": "For God hath not given us the spirit of fear;", "para_end": false, "in_line": false, "idx": 700}, {"kind": "verse", "text": "but of power, and of love,", "para_end": false, "in_line": false, "idx": 701}, {"kind": "verse", "text": "and of a sound mind.", "para_end": false, "in_line": false, "idx": 702}, {"kind": "ref", "text": "Second Timothy one, verse seven.", "para_end": true, "in_line": false, "idx": 709}, {"kind": "verse", "text": "It is vain for you to rise up early,", "para_end": false, "in_line": false, "idx": 710}, {"kind": "verse", "text": "to sit up late, to eat the bread of sorrows:", "para_end": false, "in_line": false, "idx": 711}, {"kind": "verse", "text": "for so he giveth his beloved sleep.", "para_end": false, "in_line": false, "idx": 712}, {"kind": "ref", "text": "Psalm one twenty-seven, verse two.", "para_end": true, "in_line": false, "idx": 719}]